{
  "name": "@hsorby/changelog",
  "version": "3.0.3",
  "description": "Generate a changelog for pull requests referencing issues in a repository workflow.",
  "keywords": [
    "changelog"
  ],
  "homepage": "https://github.com/hsorby/lerna-changelog#readme",
  "bugs": {
    "url": "https://github.com/hsorby/lerna-changelog/issues"
  },
  "license": "MIT",
  "author": "Bo Borgerson <gigabo@gmail.com>",
  "files": [
    "bin",
    "lib",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "gen-changelog": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsorby/lerna-changelog.git"
  },
  "scripts": {
    "build": "yarn clean && tsc",
    "changelog": "node ./bin/cli.js",
    "clean": "rimraf lib",
    "fix": "yarn lint -- --fix",
    "lint": "eslint src --ext ts --format stylish",
    "prepack": "yarn build",
    "prettier": "prettier --write 'src/**/*.ts'",
    "release": "release-it",
    "test": "jest",
    "test-ci": "yarn build && yarn test",
    "watch": "yarn build -- --watch"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "execa": "^10.0.1",
    "hosted-git-info": "^10.1.1",
    "make-fetch-happen": "^16.0.1",
    "p-map": "^7.0.4",
    "progress": "^2.0.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@release-it-plugins/lerna-changelog": "^9.0.0",
    "@types/hosted-git-info": "^3.0.5",
    "@types/jest": "30.0.0",
    "@types/make-fetch-happen": "^10.0.4",
    "@types/node": "26.4.1",
    "@types/progress": "^2.0.7",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "fs-extra": "11.4.0",
    "globals": "^17.12.0",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "release-it": "^20.2.1",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "12.* || 14.* || >= 16"
  },
  "changelog": {
    "repo": "hsorby/lerna-changelog",
    "labels": {
      "uncategorized": ":grey_question: Not Specified",
      "breaking": ":boom: Breaking Change",
      "enhancement": ":rocket: Enhancement",
      "bug": ":bug: Bug Fix",
      "documentation": ":memo: Documentation",
      "maintenance": ":house: Maintenance"
    },
    "cacheDir": ".changelog"
  },
  "jest": {
    "projects": [
      {
        "displayName": "test",
        "roots": [
          "src"
        ],
        "preset": "ts-jest/presets/default-esm",
        "extensionsToTreatAsEsm": [
          ".ts"
        ],
        "moduleNameMapper": {
          "^(\\.{1,2}/.*)\\.js$": "$1"
        }
      }
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": false,
    "trailingComma": "es5"
  }
}
